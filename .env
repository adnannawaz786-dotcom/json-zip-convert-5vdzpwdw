# Environment Variables for JSON to ZIP Converter

# Vite environment variables must be prefixed with VITE_
VITE_APP_NAME=json-zip-convert
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Convert JSON data to ZIP files with interactive file tree visualization

# API Configuration (if needed for future extensions)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_MAX_FILE_SIZE=10485760
VITE_MAX_FILES_PER_ZIP=1000

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_MODE=false
VITE_ENABLE_PREVIEW_MODE=true

# UI Configuration
VITE_DEFAULT_THEME=light
VITE_ENABLE_DARK_MODE=true
VITE_ANIMATION_DURATION=300